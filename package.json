{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/security.test.ts",
    "test:api": "tsx --test tests/local-api.test.ts",
    "test:browser": "playwright test tests/browser.spec.ts --workers=1 --reporter=line --output=.test-artifacts/playwright",
    "db:migrate:local": "wrangler d1 migrations apply gosudental-production --local"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
